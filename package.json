{
  "name": "simple-maildrop",
  "version": "0.3.0",
  "description": "A simple Maildrop API wrapper",
  "author": "Luiz Figueiredo <luiz@ponto308.jp>",
  "license": "MIT",
  "keywords": [
    "Maildrop",
    "email",
    "email-test",
    "disposable"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write src tests",
    "format:check": "oxfmt --check src tests",
    "lint": "oxlint src tests --deny-warnings",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "homepage": "https://github.com/figueiredo2021/simple-maildrop#simple-maildrop",
  "bugs": {
    "url": "https://github.com/figueiredo2021/simple-maildrop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figueiredo2021/simple-maildrop.git"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
