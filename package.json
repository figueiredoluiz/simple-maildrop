{
  "name": "simple-maildrop",
  "version": "0.4.0",
  "description": "A simple Maildrop API wrapper",
  "author": "Luiz Figueiredo <luiz@ponto308.jp>",
  "license": "MIT",
  "keywords": [
    "maildrop",
    "email",
    "email-test",
    "disposable"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.3.0",
  "files": [
    "lib/**/*",
    "src/**/*",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "format": "oxfmt --write src tests",
    "format:check": "oxfmt --check src tests",
    "lint": "oxlint src tests --deny-warnings",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm test && pnpm run lint",
    "preversion": "pnpm run lint",
    "version": "pnpm run format && git add -A src"
  },
  "homepage": "https://github.com/figueiredoluiz/simple-maildrop#simple-maildrop",
  "bugs": {
    "url": "https://github.com/figueiredoluiz/simple-maildrop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figueiredoluiz/simple-maildrop.git"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
